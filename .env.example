# 环境变量模板 — 复制为 .env 后填写，切勿提交 .env 到版本库（P6）
# cp .env.example .env

# DeepSeek（OpenAI 兼容）
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-pro
LLM_MODEL_REWRITE=deepseek-v4-flash
LLM_MODEL_FALLBACKS=deepseek-v4-flash,deepseek-chat
# parse 默认 flash；generate 用 LLM_MODEL（Pro）
# LLM_MAX_TOKENS_PARSE=2500
# LLM_MAX_TOKENS_GENERATE=3500
# GEOCODE_MAX_WORKERS=4
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 前端开发源；生产部署追加实际域名（P5）
# 例：CORS_ORIGINS=http://localhost:5173,https://travel.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端生产 API（构建时注入，可选）
# VITE_API_BASE=https://api.example.com

DATA_DIR=./data

# Trip.com 航班 Deep Link（可选联盟追踪）
# TRIPCOM_AFFILIATE_ALLIANCE_ID=
# TRIPCOM_AFFILIATE_SID=
# TRIPCOM_AFFILIATE_SUB1=
# TRIPCOM_AFFILIATE_SUB3=
TRIPCOM_DEFAULT_CURRENCY=CNY
FLIGHT_INCLUDE_LETSFG=false
FLIGHT_LETSFG_TIMEOUT_SEC=300
FLIGHT_DEFAULT_PREFERENCE=balanced
FLIGHT_INCLUDE_IGNAV=true

# Ignav 航班 API（App 内结构化查价，https://ignav.com/）
IGNAV_API_KEY=your_ignav_api_key_here

# ── 和风天气 QWeather（WX-* · https://dev.qweather.com/docs/）──
# 凭据 ID 仅作控制台对照；请求认证用 API KEY（或 JWT，见官方文档）
# QWEATHER_CREDENTIAL_ID=
QWEATHER_API_KEY=your_qweather_api_key_here
# 免费订阅常用：https://devapi.qweather.com ；正式：https://api.qweather.com
QWEATHER_API_HOST=https://devapi.qweather.com
# 可选：JWT 认证（2027 年起 API KEY 将限流，长期建议迁 JWT）
# QWEATHER_JWT_KID=
# QWEATHER_JWT_PRIVATE_KEY_PATH=

# ── Tavily 联网检索（WS-* · https://docs.tavily.com/）──
TAVILY_API_KEY=your_tavily_api_key_here
# Cursor / 编码 Agent 用 Remote MCP（勿把真实 Key 写进仓库文档）
# 控制台生成 URL 形如：https://mcp.tavily.com/mcp/?tavilyApiKey=...
# TAVILY_MCP_URL=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
