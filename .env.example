# 环境变量模板 — 复制为 .env 后填写，切勿提交 .env 到版本库（P6）
# cp .env.example .env

# DeepSeek（OpenAI 兼容）
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-pro
LLM_MODEL_REWRITE=deepseek-v4-flash
LLM_MODEL_FALLBACKS=deepseek-v4-flash,deepseek-chat
# parse 默认 flash；generate 用 LLM_MODEL（Pro）
# LLM_MAX_TOKENS_PARSE=2500
# 行程生成建议 ≥8000（reasoning 模型易截断；见问题日志 P90）
# LLM_MAX_TOKENS_GENERATE=8000
# GEOCODE_MAX_WORKERS=4
# GEOCODE_TIMEOUT_SEC=6
# NOMINATIM_TIMEOUT_SEC=6
# GEOCODE_FENCE_KM=150
# GEO-CACHE-01 / GEO-13：行程 geocode TTL（秒；0=禁用写缓存）
# GEOCODE_CACHE_TTL_SEC=86400
# GEOCODE_CACHE_MISS_TTL_SEC=600
# DEST_CENTER_CACHE_TTL_SEC=86400
# DEST_CENTER_CACHE_MISS_TTL_SEC=600
# WEATHER_CACHE_TTL_SEC=14400
# SERP_CIRCUIT_BACKOFF_SEC=120
# L1 主源 SerpApi Google Maps，回退 Photon/Nominatim（无 Key 时自动跳过 serpapi）
GEOCODE_PROVIDERS=serpapi,photon,nominatim
# https://serpapi.com/manage-api-key · 勿提交真实 Key
SERPAPI_API_KEY=your_serpapi_api_key_here
# SERPAPI_BASE_URL=https://serpapi.com
# SERPAPI_TIMEOUT_SEC=20
# 通勤查询复用 SERPAPI_API_KEY（engine=google_maps_directions）· TRN-01/02

# ── RollingGo 酒店 MCP（HOT-RG-01/02 · 与 Trip 深链并存）──
# 申请：https://rollinggo.store/apply · 国内端点 mcp.rollinggo.cn
# Cursor：复制 .cursor/mcp.json.example → .cursor/mcp.json，填 Bearer（mcp.json 已 gitignore）
# 后端 lodging：同 Key 调 searchHotels → 片区候选钉（HOT-RG-02）
# 或设系统环境变量 ROLLINGGO_MCP_API_KEY 后在 mcp.json 用 ${env:ROLLINGGO_MCP_API_KEY}
ROLLINGGO_MCP_API_KEY=your_rollinggo_mcp_api_key_here
# ROLLINGGO_MCP_URL=https://mcp.rollinggo.cn/mcp
# ROLLINGGO_MCP_TIMEOUT_SEC=45
# 片区 lodging 默认不用 Serp Maps（省额度）；需要时再开
# LODGING_ENABLE_SERP=false

# ACT-POOL / doc 34：封闭景点池 + 出池执法（Maps 仅在 verified 种子不足时补一次）
# CLOSED_POI_ENFORCE=true
# CLOSED_POI_MAPS_ENABLE=true
# CLOSED_POI_MAPS_MIN_SEED=4
# CLOSED_POI_MAPS_LIMIT=16
# CLOSED_POI_POOL_MAX=24
# CLOSED_POI_MAX_KM=35
# CLOSED_POI_MATCH_THRESHOLD=0.72
# CLOSED_POI_ADOPT_GEOCODE_MAX=8

# EdgeEditor「查询通勤」按需调用；海路/山路等可走提示词兜底
# geocode 后仅对可疑边自动补算（默认开；全量 Directions 仍关闭）
# COMMUTE_AUTO_ENRICH=true
# COMMUTE_AUTO_USE_DIRECTIONS=true
# COMMUTE_AUTO_MAX_EDGES=8
# COMMUTE_CACHE_TTL_SEC=604800
# COMMUTE_SUSPICIOUS_WALK_M=900
# COMMUTE_SUSPICIOUS_LONG_M=3000
DEEPSEEK_API_KEY=your_api_key_here
# 勿指向不可信 base（SEC-04：须 https 且主机在 allowlist，见 config.py）
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 前端开发源；生产部署追加实际域名（P5）
# 例：CORS_ORIGINS=http://localhost:5173,https://travel.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端生产 API（构建时注入，可选）
# VITE_API_BASE=https://api.example.com

DATA_DIR=./data

# Trip.com 航班 Deep Link（可选联盟追踪）
# TRIPCOM_AFFILIATE_ALLIANCE_ID=
# TRIPCOM_AFFILIATE_SID=
# TRIPCOM_AFFILIATE_SUB1=
# TRIPCOM_AFFILIATE_SUB3=
TRIPCOM_DEFAULT_CURRENCY=CNY
FLIGHT_INCLUDE_LETSFG=false
FLIGHT_LETSFG_TIMEOUT_SEC=300
# LetsFG：可选外部 CLI（不在 requirements.txt）。默认关闭；主源用 Ignav。
# 启用前须自行 pip install，并确认合规/ToS（爬取 OTA 有封号与法律风险）。见 FLT-LETSFG。
FLIGHT_DEFAULT_PREFERENCE=balanced
FLIGHT_INCLUDE_IGNAV=true

# Ignav 航班 API（App 内结构化查价，https://ignav.com/）
IGNAV_API_KEY=your_ignav_api_key_here

# ── 和风天气 QWeather（WX-* · https://dev.qweather.com/docs/）──
# 凭据 ID 仅作控制台对照；请求认证用 Header X-QW-Api-Key（或 JWT）
# QWEATHER_CREDENTIAL_ID=
QWEATHER_API_KEY=your_qweather_api_key_here
# 必填：控制台 → 设置 中的专属 API Host（形如 https://xxxx.yy.qweatherapi.com）
# 勿再用共享域名 devapi/api.qweather.com（2026 起会 403 Invalid Host）
# 勿将 *_API_BASE / *_HOST 指向不可信地址（SEC-04：可外泄 Key）
QWEATHER_API_HOST=https://xxxx.yy.qweatherapi.com
# 可选：JWT 认证（2027 年起 API KEY 将限流，长期建议迁 JWT）
# QWEATHER_JWT_KID=
# QWEATHER_JWT_PRIVATE_KEY_PATH=

# ── Tavily 联网检索（WS-* · https://docs.tavily.com/）──
TAVILY_API_KEY=your_tavily_api_key_here
# Cursor / 编码 Agent 用 Remote MCP（勿把真实 Key 写进仓库文档）
# 控制台生成 URL 形如：https://mcp.tavily.com/mcp/?tavilyApiKey=...
# TAVILY_MCP_URL=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# ── TikHub UGC（小红书等 · WS-07 · https://api.tikhub.io / https://docs.tikhub.io）──
# 只放 API Key；登录密码勿写入仓库或 .env
TIKHUB_API_KEY=your_tikhub_api_key_here
TIKHUB_API_BASE=https://api.tikhub.io
# TIKHUB_TIMEOUT_SEC=30
# TIKHUB_MAX_RESULTS=8
# EvidencePack TTL 缓存（秒；0=关闭；默认 7 天）· WS-CACHE
# EVIDENCE_CACHE_TTL_SEC=604800
# 轻量 POI 抽取 + geocode 围栏校验 · WS-08a
# EVIDENCE_POI_VALIDATE=true
# EVIDENCE_POI_VALIDATE_MAX=5
