# Trip.com Affiliate（可选，私人自用可留空）
# TRIPCOM_AFFILIATE_ALLIANCE_ID=
# TRIPCOM_AFFILIATE_SID=
# TRIPCOM_AFFILIATE_SUB1=
# TRIPCOM_AFFILIATE_SUB3=
# TRIPCOM_DEFAULT_CURRENCY=CNY

# LetsFG / Duffel（默认关闭）
# FLIGHT_INCLUDE_LETSFG=false
# FLIGHT_LETSFG_TIMEOUT_SEC=300

# Ignav（Tier 1.5 — https://ignav.com/ 注册，1000 次免费）
# 推荐写在 travel 根目录 .env（脚本会自动读取）
# IGNAV_API_KEY=
